# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Required (server refuses to start without these) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/wardrobe-manager
JWT_SECRET=change-me-to-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (OTP signup verification + password reset) ---
# Gmail requires an App Password, NOT your account password:
#   1. Turn on 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords -> generate -> paste below
# Spaces in the generated password are stripped automatically.
SMTP_USER=prahlad.singh.dev@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=Wardrobe Manager

# --- Optional ---
PORT=5009
NODE_ENV=development
CLIENT_ORIGIN=*
JWT_EXPIRES_IN=30d

# Weather-aware suggestions. Without a key a mild-weather mock is used.
OPENWEATHER_API_KEY=
# Background removal on item photos. Without a key the toggle is ignored.
REMOVEBG_API_KEY=
# Receipt OCR. Without a key OCR.space's rate-limited demo key is used.
OCR_API_KEY=
# Barcode lookup. Without keys UPCItemDB's rate-limited trial endpoint is used.
UPC_API_KEY=
UPC_API_USER_KEY=
