{
  "expo": {
    "name": "FoldD",
    "slug": "wardrobe-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#631324"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wardrobemanager.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#7E142C"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#631324",
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FoldD to use your location to suggest weather-appropriate outfits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FoldD to access your photos to add clothing items.",
          "cameraPermission": "Allow FoldD to use your camera to photograph clothing items."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FoldD to use your camera to scan barcodes and receipts.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "owner": "prahladsingh7512s-team",
    "extra": {
      "eas": {
        "projectId": "7e4fc839-ead3-44f0-9641-332db899fe83"
      }
    }
  }
}
