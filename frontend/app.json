{
  "expo": {
    "name": "Wardrobe Manager",
    "slug": "wardrobe-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E4"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wardrobemanager.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E4"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E4",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wardrobe Manager to use your location to suggest weather-appropriate outfits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wardrobe Manager to access your photos to add clothing items.",
          "cameraPermission": "Allow Wardrobe Manager to use your camera to photograph clothing items."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wardrobe Manager to use your camera to scan barcodes and receipts."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-status-bar"
    ],
    "owner": "prahladsingh7512",
    "extra": {
      "eas": {
        "projectId": "7f275af4-bd95-48eb-a24a-0744a6526946"
      }
    }
  }
}
